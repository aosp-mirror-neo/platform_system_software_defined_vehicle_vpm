package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libsdv_vpm_api",
    crate_name: "sdv_vpm_api",
    protos: [
        "*.proto",
    ],
    source_stem: "sdv_vpm_api",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    rustlibs: [
        "libvsidl_v1_stdlib_proto_rs",
    ],
    exported_include_dirs: ["."],
    vendor_available: true,
    product_available: true,
    host_supported: true,
    min_sdk_version: "35",
}

filegroup {
    name: "libsdv_vpm_protos",
    srcs: ["*.proto"],
}

filegroup {
    name: "vpm_v1_catalog_files",
    srcs: [
        ":libsdv_vpm_protos",
        "*.vsidl",
        "Android.bp",
    ],
}

filegroup {
    name: "system_software_defined_vehicle_automotive_services_vpm_stable_vsidl",
    srcs: ["**/*"],
}
